# ============================================================================
# .env.example — Transient Event Detection
# ============================================================================
# Copy this file to .env and fill in real values before running Docker.
#
#   cp .env.example .env
#
# .env is gitignored — never commit the real file.
# This template is safe to commit (contains no real secrets).
#
# Quick start:
#   1. cp .env.example .env
#   2. Fill in all CHANGE_ME values
#   3. docker compose up --build
# ============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by: postgres container, api-server, migrate service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# URL-encoded form of POSTGRES_PASSWORD — replace @ with %40, # with %23, etc.
# Example: if password is "my@pass#1", set this to "my%40pass%231"
POSTGRES_PASSWORD_URLENC=CHANGE_ME
POSTGRES_DB=Astro-sentinel

# Used for local (non-Docker) development only — Docker compose builds
# DATABASE_URL from POSTGRES_USER / POSTGRES_PASSWORD_URLENC / POSTGRES_DB above.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/Astro-sentinel

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# ── ORCID OAuth ──────────────────────────────────────────────────────────────
ORCID_CLIENT_ID=APP-CHANGE_ME
ORCID_CLIENT_SECRET=CHANGE_ME
VITE_ORCID_CLIENT_ID=APP-CHANGE_ME

# ── Astro-COLIBRI OpenAI extraction (Priority #8) ─────────────────────────────
# A SECOND, INDEPENDENT extraction alongside the Gemini one below — not a
# replacement. Two extractors that disagree about a circular is useful
# evidence; a silent substitution would destroy it.
#
# ⚠ THIS IS THE ONLY CODE PATH IN THIS REPOSITORY THAT SPENDS MONEY.
#   Set these to real values ONLY on the designated Mac Mini deployment.
#   Never in local dev, never in CI, never committed.
#
# Absent or false — which is every other environment, including this file —
# makes the path a deliberate no-op that constructs no OpenAI client and
# makes no network call. The flag is checked before the API key is even read,
# so "no key present" is never what stops a call from happening.
CIRCULAR_OPENAI_EXTRACTION_ENABLED=false
OPENAI_API_KEY=CHANGE_ME

# Worst case per circular is (retries + 1) attempts x timeout, per model.
# The package defaults (120 s, 2 retries) give 366 s; these give ~122 s, which
# is what the Node worker's deadline is sized against.
GCN_PHOTOMETRY_AI_TIMEOUT_SECONDS=60
GCN_PHOTOMETRY_AI_RETRIES=1

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# ── LLM provider (vendor-neutral) ─────────────────────────────────────────────
# Preferred over the GEMINI_* variables above, which are kept working for
# backward compatibility. Business logic depends on the LLMProvider interface,
# never on a vendor SDK, so switching provider or model is exactly these four
# variables — no code change.
#
#   LLM_PROVIDER = gemini | deepseek | qwen | openai-compatible
#   LLM_BASE_URL is required only for openai-compatible; deepseek and qwen have
#   built-in endpoints. LLM_MODEL falls back to each provider's default.
#
# SERVER-SIDE ONLY. Never prefix any of these with VITE_ — that would compile
# the key into the browser bundle.
LLM_PROVIDER=gemini
LLM_API_KEY=CHANGE_ME
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=45000

# ── GCN Circulars (human-authored scientific reports) ────────────────────────
# Used by: python-backend (gcn.circulars topic) and api-server (ingestion,
# association, AI extraction).
#
# Circulars are consumed on the SAME Kafka connection as notices and travel the
# SAME Python -> Node WebSocket bridge, on their own message type. They never
# pass through the machine-alert scientific filter.

# Consume the gcn.circulars topic at all. false = notices only; nothing else
# about the system changes.
GCN_CIRCULARS_ENABLED=true

# Run the AI enrichment loop. false = circulars are still ingested, associated,
# stored and served — they simply carry no AI extraction. A legitimate way to
# run this system, and the correct setting when no LLM is configured.
CIRCULAR_AI_EXTRACTION=true

# Enrichment worker tuning. The defaults are deliberately unhurried: nothing
# about an extraction is urgent, because the circular is already visible.
CIRCULAR_EXTRACTION_POLL_MS=15000
CIRCULAR_EXTRACTION_BATCH=3
# Bounded retries. Configuration errors and schema violations are never
# retried at all — retrying a missing key cannot succeed.
CIRCULAR_EXTRACTION_MAX_ATTEMPTS=4

# Level-3 association: attach a circular that carries NO usable event
# identifier by event type and temporal proximity.
#
# OFF BY DEFAULT, on purpose. A circular's only timestamp is when a human
# pressed send, which is not the trigger time — follow-up circulars appear
# hours to weeks after the burst, and a busy night produces several candidate
# GRBs inside any plausible window. A wrong probabilistic attachment corrupts
# an event's scientific record in a way that is hard to notice, so an honest
# UNMATCHED is preferred. Enable only where a curator reviews the results;
# every such association is stored and displayed as PROBABILISTIC.
GCN_CIRCULAR_PROBABILISTIC_ASSOCIATION=false
GCN_CIRCULAR_PROBABILISTIC_WINDOW_HOURS=48

# ── GCN Kafka Credentials (NASA General Coordinates Network) ──────────────────
# Obtain at: https://gcn.nasa.gov/quickstart
# Used by: python-backend (GCN Kafka consumer)
GCN_CLIENT_ID=CHANGE_ME
GCN_CLIENT_SECRET=CHANGE_ME

# ── Public address of this deployment ────────────────────────────────────────
# Used to build team-invitation links and the event links in notifications.
#
# It CANNOT be derived from the incoming request: behind nginx/compose the
# api-server only sees an internal host and port, so a link built from the Host
# header resolves nowhere outside the Docker network. Left unset, invitation
# links fall back to http://localhost:5173 and will not work for anyone else.
#
# No trailing slash. Example: https://ted.yourlab.edu
PUBLIC_APP_URL=

# ── Email Notification Infrastructure ────────────────────────────────────────
# Used by: api-server notification pipeline (Phase 5.1)
#
# Provider selection (choose one): smtp | resend | sendgrid | none
# Set to "none" to disable all email notifications (safe default for dev).
EMAIL_PROVIDER=none

# Comma-separated list of recipient email addresses
NOTIFICATION_RECIPIENTS=researcher@lab.edu,pi@observatory.edu

# Sender identity shown in email From: header
NOTIFICATION_FROM_EMAIL=alerts@astrosentinel.io
NOTIFICATION_FROM_NAME=Transient Event Detection Alerts

# Notification behaviour
# Only events at or above this level trigger emails: CRITICAL | HIGH | MEDIUM | LOW
NOTIFY_MIN_PRIORITY=HIGH
# Send email on event revisions (updated localizations, etc.)? true | false
NOTIFY_ON_REVISIONS=false

# ── SMTP settings (EMAIL_PROVIDER=smtp) ──────────────────────────────────────
# Works with Gmail App Password, Outlook, or any SMTP relay.
# Gmail: enable 2FA → generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Resend (EMAIL_PROVIDER=resend) ───────────────────────────────────────────
# Obtain at: https://resend.com — free tier: 100 emails/day, 3000/month
RESEND_API_KEY=re_CHANGE_ME

# ── SendGrid (EMAIL_PROVIDER=sendgrid) ───────────────────────────────────────
# Obtain at: https://sendgrid.com — free tier: 100 emails/day
SENDGRID_API_KEY=SG.CHANGE_ME

# ── Scientific Priority Classification Engine (Phase 5.2) ────────────────────
# Score-to-priority boundaries. Scores are 0–100 aggregate.
# P0 (Critical) = immediate email. P1 (High) = immediate email.
# P2 (Medium)   = digest only.    P3 (Low)  = database only.
PRIORITY_SCORE_P0=70
PRIORITY_SCORE_P1=45
PRIORITY_SCORE_P2=20

# GW false alarm rate thresholds [Hz] — lower = rarer = more significant
# Default: 1e-8 Hz ≈ 1 per 3 years (critical), 1e-6 Hz ≈ 1 per 11 days (high)
PRIORITY_GW_FAR_CRITICAL=1e-8
PRIORITY_GW_FAR_HIGH=1e-6

# GRB fluence thresholds [erg/cm²]
PRIORITY_GRB_FLUENCE_HIGH=1e-6
PRIORITY_GRB_FLUENCE_MEDIUM=1e-7

# GRB T90 duration boundary [s] — > 2s = long-duration GRB (collapsar)
PRIORITY_GRB_T90_LONG=2.0

# Signal-to-noise ratio thresholds
PRIORITY_SNR_HIGH=10.0
PRIORITY_SNR_MEDIUM=5.0

# Sky localization error radius thresholds [arcmin]
# < 30 arcmin = good (follow-up feasible), > 300 arcmin = poor
PRIORITY_LOCALIZATION_GOOD=30
PRIORITY_LOCALIZATION_POOR=300

# Score deducted per event revision (max total deduction)
PRIORITY_REVISION_PENALTY=5
PRIORITY_REVISION_PENALTY_MAX=15

# ---------------------------------------------------------------------------
# Phase 5.4 — Multi-Messenger Correlation Engine
# ---------------------------------------------------------------------------

# Temporal coincidence windows [seconds]
# GW + GRB: ±5 s (based on GW170817 + GRB 170817A: ΔT = +1.74 s)
CORR_WINDOW_GW_GRB_SEC=5
# GW + NU:  ±500 s (extended window for neutrino precursor/extended emission)
CORR_WINDOW_GW_NU_SEC=500
# GW + FRB: ±1 s (coherent radio burst models require tight timing)
CORR_WINDOW_GW_FRB_SEC=1
# GRB + NU: ±500 s (collapsar neutrino burst, prompt + extended)
CORR_WINDOW_GRB_NU_SEC=500
# GRB + FRB: ±1 s (speculative short GRB remnant emission)
CORR_WINDOW_GRB_FRB_SEC=1
# Default window for any other event type pair
CORR_WINDOW_DEFAULT_SEC=60

# Spatial coincidence factor (N-sigma)
# Match when: angular_separation <= FACTOR × (errorRadius_A + errorRadius_B)
CORR_SPATIAL_FACTOR=3.0

# Confidence score boundaries [0-100]
CORR_SCORE_HIGH=70
CORR_SCORE_MEDIUM=40
CORR_SCORE_LOW=15

# How far back to look in the database for candidate events [minutes]
# Should be >= max(CORR_WINDOW_GW_NU_SEC, CORR_WINDOW_GRB_NU_SEC) / 60 + buffer
CORR_DB_LOOKBACK_MINUTES=15

# ---------------------------------------------------------------------------
# Phase 5.5 — Intelligent Notification Deduplication Engine
# ---------------------------------------------------------------------------

# Minimum priority score increase required to trigger a re-send
# Example: 15 points (e.g., FAR drops below critical threshold, adding +15)
DEDUP_SCORE_DELTA=15

# Minimum percentage reduction in error radius required to trigger a re-send
# Example: 25 (25% tighter localization)
DEDUP_LOCALIZATION_PCT=25

# Always send an email when the lifecycle reaches "confirmed", even if no 
# other parameters have significantly improved.
DEDUP_SEND_ON_CONFIRMED=true

# ---------------------------------------------------------------------------
# Scientific Intelligence Layer — cosmology (spec section 33)
# ---------------------------------------------------------------------------

# Cosmological model used for every distance-, redshift- and energy-derived
# quantity. It is stamped onto each derived value so results are reproducible.
# Recognised: Planck18 (default) | Planck15 | WMAP9
#
# An unrecognised value is NOT silently replaced by a default: nothing
# cosmological is derived, and the reason is reported on the event.
ASTROSENTINEL_COSMOLOGY=Planck18

# ---------------------------------------------------------------------------
# Scientific Intelligence Layer — observing site (spec sections 21-22)
# ---------------------------------------------------------------------------

# Altitude, azimuth and airmass are properties of an observer, not of an
# event. With no site configured they are reported as UNKNOWN — they are never
# computed from a default or "typical" location, because that would silently
# attach one observatory's sky to every user's dashboard.
#
# Set BOTH latitude and longitude to enable them. A half-configured site is a
# configuration error, not something to complete with zeros: (0, 0) is a real
# place in the Gulf of Guinea and would yield plausible, wrong altitudes.
#
# Example — ESO Paranal:
#   ASTROSENTINEL_SITE_NAME=Paranal
#   ASTROSENTINEL_SITE_LAT=-24.6275
#   ASTROSENTINEL_SITE_LON=-70.4044
#   ASTROSENTINEL_SITE_ELEV_M=2635
ASTROSENTINEL_SITE_NAME=
ASTROSENTINEL_SITE_LAT=
ASTROSENTINEL_SITE_LON=
ASTROSENTINEL_SITE_ELEV_M=

# ─────────────────────────────────────────────────────────────────────────────
# Notification providers — WeChat / WeCom
# ─────────────────────────────────────────────────────────────────────────────
#
# NOTIFICATION_ENCRYPTION_KEY encrypts provider credentials at rest in
# alerts.alert_subscriptions.channel_config (AES-256-GCM). A WeCom robot
# webhook URL is a BEARER CREDENTIAL — anyone holding it can post to the group
# — so it is never stored in plaintext and never returned by any endpoint.
#
# Without this key the WeChat configuration endpoints return 503 rather than
# falling back to storing a secret in the clear.
#
# Generate with:  openssl rand -hex 32
# Rotating it invalidates every stored credential; users must re-save theirs.
NOTIFICATION_ENCRYPTION_KEY=

# true routes every provider send to an in-process sink instead of the network.
# Use it to exercise the pipeline without posting to a real WeCom group.
NOTIFICATION_TEST_MODE=false

# Delivery retry tuning. Defaults: 5 attempts on the ladder below.
NOTIFICATION_MAX_ATTEMPTS=5
# Comma-separated milliseconds: immediate, 5s, 30s, 2min, 10min.
NOTIFICATION_RETRY_BACKOFF_MS=0,5000,30000,120000,600000
# Fraction of jitter applied to each backoff (0 disables; 0.2 = ±20%).
# Jitter stops a provider outage retrying every queued alert at the same instant.
NOTIFICATION_RETRY_JITTER=0.2

# NOTE: the WeCom webhook itself is deliberately NOT an environment variable.
# It is per-user configuration, entered in the Research Notification Center and
# stored encrypted per subscription. A global webhook would send every lab's
# alerts to one group.
#
# WECOM_CORP_ID / WECOM_AGENT_ID / WECOM_SECRET are NOT used: those belong to
# the WeCom Application Messaging API, a different transport from the group
# robot webhook implemented here. They are omitted rather than listed-unused.

# ─────────────────────────────────────────────────────────────────────────────
# GRB ingestion thresholds (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Measured against the live broker these reject nothing — 8 GRB notices
# received, 8 accepted. They are exposed so the ceiling can be opened
# deliberately and reversibly. Set to 0 to accept everything the instrument
# reports, INCLUDING sub-threshold triggers that are usually detector noise.
GRB_SWIFT_MIN_IMAGE_SIGNIFICANCE=6.0
GRB_EP_MIN_SNR=5.0
#
# NOT configurable, by design: TEST packets, retractions, and Fermi's
# Def_NOT_a_GRB flag (a trigger the flight software already attributed to a
# particle event, solar flare or known source). Those are not quality
# thresholds — admitting them would put non-events on the dashboard as bursts.
